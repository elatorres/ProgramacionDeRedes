<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>_06_gRPC_04_GrpcStreamingClient</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Google.Protobuf" Version="3.37.0-rc1" />
        <PackageReference Include="Grpc.Net.Client" Version="2.84.0" />
        <PackageReference Include="Grpc.Tools" Version="2.85.0-pre1">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>    
    
    <ItemGroup>
        <Protobuf Include="Protos\count.proto" GrpcServices="Client" />
    </ItemGroup>

</Project>
